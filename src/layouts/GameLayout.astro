---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import type { PlatformLink } from "../data/games";

interface Props {
	title: string;
	description?: string;
	image?: string;
	platforms?: PlatformLink[];
	lightTopbar?: boolean;
	accent?: string;
}

const { title, description, image, platforms = [], lightTopbar = false, accent } = Astro.props;

const platformOS: Record<PlatformLink["type"], string | null> = {
	steam: "Windows",
	appstore: "iOS",
	googleplay: "Android",
	learn: null,
};

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image ?? "/img/common/cp_social_preview.png", Astro.site);

const videoGameSchema = {
	"@context": "https://schema.org",
	"@type": "VideoGame",
	name: title,
	description: description ?? "Cipher Prime is a small multi-award winning creative studio in Philadelphia.",
	image: imageURL.toString(),
	url: canonicalURL.toString(),
	publisher: { "@type": "Organization", name: "Cipher Prime", url: "https://cipherprime.com" },
	...(platforms.some((p) => platformOS[p.type])
		? { gamePlatform: [...new Set(platforms.map((p) => platformOS[p.type]).filter(Boolean))] }
		: {}),
	...(platforms.filter((p) => p.type !== "learn").length
		? { sameAs: platforms.filter((p) => p.type !== "learn").map((p) => p.href) }
		: {}),
};
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={image} />
		<script type="application/ld+json" set:html={JSON.stringify(videoGameSchema)} />
	</head>
	<body style={accent ? `--accent: ${accent}; --accent-dim: color-mix(in srgb, ${accent} 72%, black);` : undefined}>
		<div class:list={["topbar", { light: lightTopbar }]}>
			<div class="topbar-inner contain">
				<a class="brand" href="/">
					<img src={lightTopbar ? "/img/common/cp_logotype_black.webp" : "/img/common/cp_logotype_white.webp"} alt="Cipher Prime" />
				</a>
			</div>
		</div>

		<slot />

		<Footer />
	</body>
</html>

<style>
	.topbar {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		z-index: 5;
		padding-block: 22px;
	}
	.topbar-inner {
		display: flex;
		align-items: center;
	}
	.topbar .brand {
		display: flex;
		align-items: center;
		text-decoration: none;
		opacity: 0.85;
	}
	.topbar .brand img {
		height: 18px;
		width: auto;
	}
	@media (min-width: 900px) {
		.topbar .brand img {
			height: 26px;
		}
	}
</style>
