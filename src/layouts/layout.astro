---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";

interface Props {
	title: string;
	description?: string;
	image?: string;
	hideNav?: boolean;
}

const { title, description, image, hideNav = false } = Astro.props;

const organizationSchema = {
	"@context": "https://schema.org",
	"@type": "Organization",
	name: "Cipher Prime",
	url: "https://cipherprime.com",
	logo: new URL("/img/common/cp_logotype_black.webp", Astro.site).toString(),
	sameAs: ["https://twitter.com/cipherprime", "https://github.com/cipherprime", "https://music.cipherprime.com"],
};
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={image} />
		<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
	</head>
	<body>
		{!hideNav && (
			<header class="site-header">
				<nav>
					<a href="/#games">Games</a>
					<a href="/about">About</a>
					<a href="/mailinglist">Mailing List</a>
				</nav>
			</header>
		)}

		<main class="contain">
			<slot />
		</main>

		<Footer />
	</body>
</html>

<style>
	body {
		background: var(--cp-paper);
		color: var(--cp-dark-text);
	}

	.site-header {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: flex-end;
		padding: 22px 28px;
		background: linear-gradient(180deg, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0));
	}
	.site-header nav {
		display: flex;
		gap: 22px;
	}
	.site-header nav a {
		text-decoration: none;
		font-size: var(--fs-base);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--cp-text-dim);
	}
	.site-header nav a:hover {
		color: #fff;
	}

	main {
		padding-top: 96px;
		padding-bottom: 60px;
	}

</style>
