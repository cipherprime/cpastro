---
export interface Accolade {
	label: string;
	source: string;
}

export interface Quote {
	quote: string;
	cite: string;
}

interface Props {
	quotes: Quote[];
	accolades?: Accolade[];
}

const { quotes, accolades = [] } = Astro.props;
---

<section class="press">
	<div class="press-inner contain-narrow align-center">
		<div class="eyebrow">What people said</div>

		<div class="carousel">
			{quotes.map((q, i) => (
				<div class="slide" data-slide style={i === 0 ? "" : "display:none"}>
					<blockquote>&ldquo;{q.quote}&rdquo;</blockquote>
					<cite>&mdash; {q.cite}</cite>
				</div>
			))}
		</div>

		{quotes.length > 1 && (
			<div class="dots" data-dots>
				{quotes.map((_, i) => (
					<button type="button" class="dot" data-dot data-index={i} aria-label={`Quote ${i + 1}`}></button>
				))}
			</div>
		)}

		{accolades.length > 0 && (
			<div class="accolades">
				{accolades.map((a) => (
					<span><b>{a.label}</b> &mdash; {a.source}</span>
				))}
			</div>
		)}
	</div>
</section>

<script define:vars={{ count: quotes.length }}>
	const section = document.currentScript.previousElementSibling;
	if (count > 1) {
		const slides = section.querySelectorAll("[data-slide]");
		const dots = section.querySelectorAll("[data-dot]");
		const carousel = section.querySelector(".carousel");
		let current = 0;
		let timer;

		function show(index) {
			current = (index + slides.length) % slides.length;
			slides.forEach((s, i) => (s.style.display = i === current ? "" : "none"));
			dots.forEach((d, i) => d.classList.toggle("active", i === current));
		}

		function start() {
			timer = setInterval(() => show(current + 1), 6000);
		}

		function stop() {
			clearInterval(timer);
		}

		dots.forEach((d) => {
			d.addEventListener("click", () => {
				show(Number(d.dataset.index));
				stop();
				start();
			});
		});

		show(0);
		start();
		carousel.addEventListener("mouseenter", stop);
		carousel.addEventListener("mouseleave", start);
	}
</script>

<style>
	.press {
		background: var(--cp-paper);
		color: var(--cp-dark-text);
		padding: 80px 0;
	}
	.eyebrow {
		margin-bottom: 22px;
	}
	blockquote {
		font-size: var(--fs-md);
		font-weight: 600;
		line-height: 1.35;
		margin: 0 0 14px;
		letter-spacing: -0.01em;
	}
	cite {
		font-style: normal;
		font-size: var(--fs-base);
		color: #66695c;
		letter-spacing: 0.03em;
	}
	.dots {
		display: flex;
		justify-content: center;
		gap: 8px;
		margin-top: 26px;
	}
	.dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		border: none;
		padding: 0;
		background: var(--cp-text-quiet);
		cursor: pointer;
	}
	.dot.active {
		background: var(--cp-green-dim);
	}
	.accolades {
		margin-top: 46px;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 10px 22px;
		font-size: var(--fs-base);
		color: var(--cp-paper-text-dim);
	}
	.accolades span b {
		color: var(--cp-dark-text);
	}
</style>
