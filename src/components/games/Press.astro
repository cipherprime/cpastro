---
export interface Accolade {
	label: string;
	source: string;
}

interface Props {
	quote: string;
	cite: string;
	accolades?: Accolade[];
}

const { quote, cite, accolades = [] } = Astro.props;
---

<section class="press">
	<div class="press-inner">
		<div class="eyebrow">What people said</div>
		<blockquote>&ldquo;{quote}&rdquo;</blockquote>
		<cite>&mdash; {cite}</cite>
		{accolades.length > 0 && (
			<div class="accolades">
				{accolades.map((a) => (
					<span><b>{a.label}</b> &mdash; {a.source}</span>
				))}
			</div>
		)}
	</div>
</section>

<style>
	.press {
		background: var(--cp-paper);
		color: #1c1e16;
		padding: 80px 24px;
	}
	.press-inner {
		max-width: 760px;
		margin: 0 auto;
		text-align: center;
	}
	.eyebrow {
		font-size: 11px;
		text-transform: uppercase;
		letter-spacing: 0.22em;
		color: var(--cp-green-dim);
		font-weight: 700;
		margin-bottom: 22px;
	}
	blockquote {
		font-size: clamp(20px, 3.4vw, 30px);
		font-weight: 600;
		line-height: 1.35;
		margin: 0 0 14px;
		letter-spacing: -0.01em;
	}
	cite {
		font-style: normal;
		font-size: 13px;
		color: #66695c;
		letter-spacing: 0.03em;
	}
	.accolades {
		margin-top: 46px;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 10px 22px;
		font-size: 12.5px;
		color: #4a4c40;
	}
	.accolades span b {
		color: #1c1e16;
	}
</style>
