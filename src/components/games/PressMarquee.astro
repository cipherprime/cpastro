---
export interface Quote {
	quote: string;
	cite: string;
}

interface Props {
	quotes: Quote[];
	accent?: string;
}

const { quotes = [], accent } = Astro.props;

const items = quotes.map((q) => ({ text: `“${q.quote}”`, tag: q.cite }));
---

{items.length > 0 && (
	<section class="press-marquee" style={accent ? `--accent-local: ${accent}` : undefined}>
		<div class="track">
			{[0, 1].map(() => (
				<div class="lane" aria-hidden={"false"}>
					{items.map((it) => (
						<span class="item">
							<span class="text">{it.text}</span>
							<span class="tag">{it.tag}</span>
							<span class="glyph">&#9670;</span>
						</span>
					))}
				</div>
			))}
		</div>
	</section>
)}

<style>
	.press-marquee {
		background: var(--accent-local, var(--accent));
		color: #06120a;
		padding: 22px 0;
		overflow: hidden;
	}
	.track {
		display: flex;
		width: max-content;
		animation: scroll 38s linear infinite;
	}
	.press-marquee:hover .track {
		animation-play-state: paused;
	}
	.lane {
		display: flex;
		align-items: center;
		flex-shrink: 0;
	}
	.item {
		display: inline-flex;
		align-items: baseline;
		gap: 10px;
		white-space: nowrap;
		padding: 0 22px;
		font-weight: 800;
		font-size: var(--fs-md);
		text-transform: uppercase;
		letter-spacing: 0.01em;
	}
	.item .tag {
		font-size: var(--fs-sm);
		font-weight: 600;
		opacity: 0.7;
	}
	.item .glyph {
		font-size: 0.5em;
		opacity: 0.5;
		margin-left: 12px;
	}
	@keyframes scroll {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}
</style>
