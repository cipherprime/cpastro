---
import type { PlatformType } from "../../data/games";

interface Props {
	type: PlatformType;
	href: string;
	external?: boolean;
}

const { type, href, external = type !== "learn" } = Astro.props;
const linkProps = external ? { target: "_blank", rel: "noopener" } : {};
---

{type === "steam" && (
	<a class="badge purchase steam" href={href} {...linkProps}>
		<img class="mark" src="/img/vendor/vendor-steam.png" alt="" />
		<span>Get it on Steam</span>
	</a>
)}
{type === "playstation" && (
	<a class="badge purchase playstation" href={href} {...linkProps}>
		<img class="mark" src="/img/vendor/vendor-playstation.png" alt="" />
		<span>Get it on PlayStation</span>
	</a>
)}
{type === "appstore" && (
	<a class="badge store" href={href} {...linkProps}><img src="/img/vendor/appstore-badge.svg" alt="App Store" /></a>
)}
{type === "googleplay" && (
	<a class="badge store" href={href} {...linkProps}><img src="/img/vendor/googleplay-badge.svg" alt="Google Play" /></a>
)}
{type === "learn" && (
	<a class="badge learn" href={href} {...linkProps}>Learn more &rarr;</a>
)}

<style>
	.badge.purchase {
		position: relative;
		display: inline-flex;
		align-items: center;
		overflow: hidden;
		color: #fff;
		font-weight: 500;
		font-size: var(--fs-md);
		text-decoration: none;
		height: 40px;
		line-height: 40px;
		padding-inline: 45px 10px;
		border-radius: var(--radius-md);
	}
	.badge.purchase.steam {
		background: linear-gradient(145deg, var(--cp-text-faint) 0%,#000 100%);
		border: 1px solid var(--cp-paper-text-dim);
	}
	.badge.purchase.playstation {
		background: linear-gradient(145deg, #001c3d 0%, #002a5c 25%, #003791 55%, #0050b3 80%, #0070cc 100%);
		border: 1px solid #003791;
	}
	.badge.purchase .mark {
		position: absolute;
		top: 50%;
		width: auto;
		transform: translateY(-50%);
	}
	.badge.purchase.steam .mark {
		left: -14px;
		height: 60%;
	}
	.badge.purchase.playstation .mark {
		left: 14px;
		height: 45%;
	}
	.badge.purchase span {
		position: relative;
	}
	.badge.store {
		display: inline-flex;
	}
	.badge.store img {
		height: 38px;
		width: auto;
	}
	.badge.learn {
		font-size: var(--fs-base);
		color: var(--accent);
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		gap: 5px;
	}
	.badge.learn:hover {
		text-decoration: underline;
	}
</style>
