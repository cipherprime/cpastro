---
interface Props {
	images: string[];
}

const { images } = Astro.props;
---

<div class="gallery">
	<div class="filmstrip">
		{images.map((src) => (
			<a href={src} target="_blank" rel="noopener"><img src={src} alt="Screenshot" /></a>
		))}
	</div>
</div>

<style>
	.gallery {
		background: #070904;
		padding: 6px 0;
	}
	.filmstrip {
		display: flex;
		gap: 6px;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		padding: 6px;
		-webkit-overflow-scrolling: touch;
	}
	.filmstrip a {
		flex: 0 0 82%;
		scroll-snap-align: center;
		border-radius: 4px;
		overflow: hidden;
	}
	.filmstrip img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		aspect-ratio: 16 / 9;
	}
	@media (min-width: 760px) {
		.filmstrip a {
			flex: 0 0 46%;
		}
	}
</style>
