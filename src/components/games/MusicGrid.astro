---
import CardGrid from "../CardGrid.astro";
import MusicCard, { type MusicItem } from "./MusicCard.astro";

interface Props {
	heading?: string;
	items: MusicItem[];
}

const { heading = "Get the soundtracks", items } = Astro.props;
---

<section class="music">
	<div class="music-inner contain align-center">
		<h2 class="section-title">{heading}</h2>
		<CardGrid columns={3} gap="20px">
			{items.map((item) => <MusicCard {...item} />)}
		</CardGrid>
	</div>
</section>

<style>
	.music {
		background: var(--cp-ink);
		padding: 80px 0;
	}
	.music-inner h2 {
		margin-bottom: 40px;
	}
</style>
