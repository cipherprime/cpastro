---
export interface Accolade {
	label: string;
	source: string;
}

interface Props {
	accolades: Accolade[];
	accent?: string;
}

const { accolades = [], accent } = Astro.props;
const [featured, ...rest] = accolades;
---

{featured && (
	<section class="awards-stat" style={accent ? `--accent-local: ${accent}` : undefined}>
		<div class="stat-inner contain-narrow align-center">
			<div class="headline">
				<span class="headline-label">{featured.label}</span>
				<span class="headline-source">{featured.source}</span>
			</div>

			{rest.length > 0 && (
				<div class="rest">
					{rest.map((a, i) => (
						<>
							{i > 0 && <span class="sep">&bull;</span>}
							<span class="chip"><b>{a.label}</b> {a.source}</span>
						</>
					))}
				</div>
			)}
		</div>
	</section>
)}

<style>
	.awards-stat {
		background: var(--cp-ink);
		padding: 90px 0 70px;
		text-align: center;
	}
	.headline {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 8px;
	}
	.headline-label {
		font-size: clamp(2.4rem, 6vw, 4rem);
		font-weight: 900;
		line-height: 1.02;
		letter-spacing: -0.02em;
		color: var(--accent-local, var(--accent));
	}
	.headline-source {
		font-size: var(--fs-base);
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--cp-text-faint);
	}
	.rest {
		margin-top: 40px;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 8px 14px;
		font-size: var(--fs-sm);
		color: var(--cp-text-faint);
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}
	.rest b {
		color: #fff;
	}
	.rest .sep {
		opacity: 0.4;
	}
</style>
