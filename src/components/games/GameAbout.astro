---
interface LinkItem {
	href: string;
	label: string;
}

interface Props {
	heading: string;
	links?: LinkItem[];
}

const { heading, links = [] } = Astro.props;
---

<section class="about">
	<div class="about-inner contain-narrow">
		{links.length > 0 && (
			<div class="links">
				{links.map((l) => <a class="link-underline" href={l.href}>{l.label}</a>)}
			</div>
		)}

		<h2 class="section-title">{heading}</h2>
		<slot />
	</div>
</section>

<style>
	.about {
		padding: 70px 0;
	}
	.about h2 {
		font-size: var(--fs-2xl);
	}
	.about :global(p) {
		font-size: var(--fs-lg);
		color: var(--cp-text-soft);
	}
	.about :global(a) {
		color: var(--accent);
	}
	.links {
		display: flex;
		justify-content: start;
		gap: 32px;
		margin-bottom: 32px;
	}
	.links a {
		font-size: var(--fs-md);
		text-transform: uppercase;
		letter-spacing: 0.14em;
		font-weight: 700;
		color: var(--accent);
	}
	.links a:hover {
		color: var(--accent);
		border-bottom-color: var(--accent);
	}
</style>
