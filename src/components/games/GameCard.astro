---
import Card from "../Card.astro";
import GamePlatformBadge from "./GamePlatformBadge.astro";
import type { PlatformLink } from "../../data/games";

interface Props {
	name: string;
	href: string;
	cover: string;
	desc: string;
	external?: boolean;
	platforms?: PlatformLink[];
	size?: "default" | "mini";
}

const { name, href, cover, desc, external = false, platforms = [], size = "default" } = Astro.props;
---

<Card variant="game" href={href} cover={cover} coverAlt={name} title={name} desc={desc} external={external} size={size}>
	{platforms.length > 0
		? platforms.map((p) => <GamePlatformBadge type={p.type} href={p.href} />)
		: <GamePlatformBadge type="learn" href={href} external={external} />}
</Card>

<style>
	:global(.card-game) {
		background: var(--cp-panel);
		border-radius: 4px;
	}
	:global(.card-game .cover) {
		aspect-ratio: 561 / 800;
	}
	:global(.card-game .cover img) {
		height: 100%;
		transition: transform 0.2s ease;
	}
	:global(.card-game .cover:hover img) {
		transform: scale(1.03);
	}
	:global(.card-game .body) {
		padding: 18px 20px 22px;
	}
	:global(.card-game h3) {
		font-size: var(--fs-xl);
		margin: 0 0 6px;
		color: #fff;
	}
	:global(.card-game .desc) {
		font-size: var(--fs-md);
		color: var(--cp-text-dim);
		line-height: 1.5;
		margin-bottom: 16px;
	}
	:global(.card-game .footer) {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
	}

	:global(.card-game.mini h3) {
		font-size: var(--fs-lg);
	}

	@media (max-width: 767px) {
		:global(.card-game.mini) {
			flex-direction: row;
			align-items: stretch;
		}
		:global(.card-game.mini .cover) {
			width: 100px;
			aspect-ratio: auto;
			flex-shrink: 0;
		}
		:global(.card-game.mini .body) {
			padding: 14px 16px;
		}
	}
</style>
