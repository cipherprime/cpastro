---
import GamePlatformBadge from "./GamePlatformBadge.astro";
import type { PlatformLink } from "../../data/games";

interface Props {
	name: string;
	href: string;
	cover: string;
	desc: string;
	external?: boolean;
	platforms?: PlatformLink[];
}

const { name, href, cover, desc, external = false, platforms = [] } = Astro.props;
const linkProps = external ? { target: "_blank", rel: "noopener" } : {};
---

<div class="game-box">
	<a class="cover" href={href} {...linkProps}><img src={cover} alt={name} /></a>
	<div class="body">
		<h3><a href={href} {...linkProps}>{name}</a></h3>
		<p class="desc">{desc}</p>
		<div class="platform-row">
			{platforms.length > 0
				? platforms.map((p) => <GamePlatformBadge type={p.type} href={p.href} />)
				: <GamePlatformBadge type="learn" href={href} external={external} />}
		</div>
	</div>
</div>

<style>
	.game-box {
		background: #171811;
		border-radius: 4px;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		height: 100%;
	}
	.game-box .cover {
		aspect-ratio: 561 / 800;
		overflow: hidden;
		display: block;
	}
	.game-box .cover img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.2s ease;
	}
	.game-box .cover:hover img {
		transform: scale(1.03);
	}
	.game-box .body {
		padding: 18px 20px 22px;
		flex: 1;
		display: flex;
		flex-direction: column;
	}
	.game-box h3 {
		font-size: var(--fs-xl);
		font-weight: 400;
		margin: 0 0 6px;
		color: #fff;
	}
	.game-box h3 a {
		text-decoration: none;
	}
	.game-box .desc {
		font-size: var(--fs-md);
		color: var(--cp-text-dim);
		line-height: 1.5;
		margin: 0 0 16px;
		flex: 1;
	}
	.game-box .platform-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		margin-top: auto;
	}

	:global(.games.minis) .game-box h3 {
		font-size: var(--fs-lg);
	}

	@media (max-width: 767px) {
		:global(.games.minis) .game-box {
			flex-direction: row;
			align-items: stretch;
		}
		:global(.games.minis) .game-box .cover {
			width: 100px;
			aspect-ratio: auto;
			flex-shrink: 0;
		}
		:global(.games.minis) .game-box .cover img {
			height: 100%;
			object-fit: cover;
		}
		:global(.games.minis) .game-box .body {
			padding: 14px 16px;
		}
	}
</style>
