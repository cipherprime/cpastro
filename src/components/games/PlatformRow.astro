---
export interface Platform {
	icon: string;
	label: string;
	dead?: boolean;
}

interface Props {
	platforms: Platform[];
}

const { platforms } = Astro.props;
---

<div class="platforms">
	{platforms.map((p) => (
		<div class:list={["p", { dead: p.dead }]}>
			<img src={p.icon} alt="" />
			<span>{p.label}</span>
		</div>
	))}
</div>

<style>
	.platforms {
		margin-top: 44px;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 26px;
		flex-wrap: wrap;
	}
	.platforms .p {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 6px;
	}
	.platforms .p img {
		height: 26px;
		width: auto;
		opacity: 0.95;
	}
	.platforms .p.dead img {
		opacity: 0.25;
		filter: grayscale(1);
	}
	.platforms .p span {
		font-size: 9.5px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--cp-text-dim);
	}
	.platforms .p.dead span {
		color: var(--cp-text-faint);
	}
</style>
