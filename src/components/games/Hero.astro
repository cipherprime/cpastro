---
import GamePlatformBadge from "./GamePlatformBadge.astro";
import type { PlatformLink } from "../../data/games";

interface Props {
	title: string;
	tagline?: string;
	logoSrc?: string;
	logoScale?: number;
	backgroundSrc: string;
	trailerHref?: string;
	compact?: boolean;
	platforms?: PlatformLink[];
}

const { title, tagline, logoSrc, logoScale = 1, backgroundSrc, trailerHref, compact = false, platforms = [] } = Astro.props;

const trailerId = trailerHref?.split("/").pop();
---

<div class:list={["hero", { compact }]} style={`background-image:url(${backgroundSrc})`}>
	<div class="hero-inner" data-hero-inner>
		{logoSrc ? (
			<div class="hero-logo" style={`--logo-scale: ${logoScale}`}><img src={logoSrc} alt={title} /></div>
		) : (
			<h1>{title}</h1>
		)}
		{tagline && <p class="tagline">{tagline}</p>}

		{platforms.length > 0 && (
			<div class="cta-row">
				{platforms.map((p) => <GamePlatformBadge type={p.type} href={p.href} />)}
			</div>
		)}

		{trailerHref && (
			<a class="trailer-link link-underline" href={trailerHref} target="_blank" rel="noopener" data-trailer-trigger data-video-id={trailerId}>▶ Watch the trailer</a>
		)}
	</div>

	{trailerHref && <div class="hero-video" data-hero-video hidden></div>}
</div>

<style>
	.hero {
		position: relative;
		min-height: 80vh;
		overflow: hidden;
		background-color: #0e1607;
		background-size: cover;
		background-position: center;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
	}
	.hero::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 0;
		background: radial-gradient(
			ellipse at 50% 40%,
			rgba(0, 0, 0, 0) 0%,
			rgba(6, 10, 3, 0.55) 62%,
			rgba(4, 7, 2, 0.9) 100%
		);
	}
	.hero-inner {
		position: relative;
		z-index: 1;
		padding: 120px 24px 64px;
		max-width: 920px;
		transition: opacity 0.25s ease;
	}
	.hero-inner.fading {
		opacity: 0;
		pointer-events: none;
	}
	.hero-video {
		position: absolute;
		inset: 0;
		z-index: 2;
		background: #000;
	}
	.hero-video[hidden] {
		display: none;
	}
	.hero-video :global(iframe) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}
	.hero-logo {
		width: calc(min(640px, 86vw) * var(--logo-scale, 1));
		margin: 0 auto 6px;
	}
	.hero-logo img {
		width: 100%;
		/* filter: drop-shadow(0 12px 40px rgba(0, 0, 0, 0.55)); */
	}
	.hero-inner h1 {
		font-size: var(--fs-2xl);
		font-weight: 400;
		margin: 0;
	}
	.tagline {
		font-size: var(--fs-lg);
		color: #d7dac9;
		max-width: 520px;
		margin: 8px auto 34px;
		text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6), 0 4px 14px rgba(0, 0, 0, 0.5);
	}
	.cta-row {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 18px;
		flex-wrap: wrap;
		margin-bottom: 10px;
	}
	.trailer-link {
		font-size: var(--fs-base);
		color: var(--cp-text-quiet);
		border-bottom-color: rgba(207, 210, 194, 0.4);
	}
	.trailer-link:hover {
		color: #fff;
		border-color: #fff;
	}
</style>

<script>
	let ytApiPromise: Promise<any> | null = null;

	function loadYouTubeApi(): Promise<any> {
		if (ytApiPromise) return ytApiPromise;
		ytApiPromise = new Promise((resolve) => {
			const w = window as any;
			if (w.YT && w.YT.Player) {
				resolve(w.YT);
				return;
			}
			const prevCallback = w.onYouTubeIframeAPIReady;
			w.onYouTubeIframeAPIReady = () => {
				prevCallback?.();
				resolve(w.YT);
			};
			const script = document.createElement("script");
			script.src = "https://www.youtube.com/iframe_api";
			document.head.appendChild(script);
		});
		return ytApiPromise;
	}

	document.querySelectorAll<HTMLAnchorElement>("[data-trailer-trigger]").forEach((trigger) => {
		const hero = trigger.closest(".hero");
		const heroInner = hero?.querySelector<HTMLElement>("[data-hero-inner]");
		const videoHost = hero?.querySelector<HTMLElement>("[data-hero-video]");
		const videoId = trigger.dataset.videoId;
		if (!hero || !heroInner || !videoHost || !videoId) return;

		let player: any = null;

		trigger.addEventListener("click", async (e) => {
			e.preventDefault();

			heroInner.classList.add("fading");
			videoHost.hidden = false;

			const YT = await loadYouTubeApi();

			if (player) {
				player.playVideo();
				return;
			}

			const mount = document.createElement("div");
			videoHost.appendChild(mount);

			player = new YT.Player(mount, {
				height: "100%",
				width: "100%",
				videoId,
				playerVars: {
					autoplay: 1,
					playsinline: 1,
					modestbranding: 1,
					rel: 0,
				},
				events: {
					onReady: (ev: any) => ev.target.playVideo(),
					onStateChange: (ev: any) => {
						if (ev.data === YT.PlayerState.ENDED) {
							videoHost.hidden = true;
							heroInner.classList.remove("fading");
						}
					},
				},
			});
		});
	});
</script>
