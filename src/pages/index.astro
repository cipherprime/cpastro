---
import Layout from "../layouts/layout.astro";
import GameCard from "../components/games/GameCard.astro";
import { games } from "../data/games";

const mainSlugs = ["lineweight", "auditorium", "splice", "pulse", "intake", "fractal"];
const miniSlugs = ["jawns", "tailwind", "shimsham", "monster-want-burger"];
const mainGames = mainSlugs.map((slug) => games.find((g) => g.slug === slug)!);
const miniGames = miniSlugs.map((slug) => games.find((g) => g.slug === slug)!);
---

<Layout title="Beautiful Games" description="Ten games, ten years — music, motion and puzzle-driven games from a small studio in Philadelphia." hideNav>
	<section class="site-hero">
		<video class="bg-video" poster="/img/common/cp-splash.png" autoplay muted loop playsinline>
			<source src="/video/sixteenseconds.webm" type="video/webm" />
		</video>
		<div class="hero-content contain">
			<div class="inner">
				<img class="mark" src="/img/common/cp-logo-white.png" alt="Cipher Prime" />
				<h1>Set Your Mind On Fire</h1>
				<p class="subhead">Cipher Prime makes games out of light and music in Philly.</p>
			</div>
		</div>
	</section>

	<div class="stack">
		<div class="page-head" id="games">
			<h2>Award-winning games.</h2>
			<p>Music, motion and puzzle-driven games from a small studio in Philadelphia — 2008 to 2020.</p>
		</div>

		<div class="games">
			{mainGames.map((game) => (
				<GameCard name={game.title} href={game.href} cover={game.cover} desc={game.shortDescription} platforms={game.platforms} />
			))}
		</div>

		<div class="minis-head">
			<h2>The Lab</h2>
			<p>Experiments, demos and one-off releases — jam-scale games, a hardware launch title, a Humble Original.</p>
		</div>

		<div class="games minis">
			{miniGames.map((game) => (
				<GameCard name={game.title} href={game.href} cover={game.cover} desc={game.shortDescription} external={game.external} platforms={game.platforms} />
			))}
		</div>

		<section class="mailinglist">
			<h2>Join the mailing list. Get a free gift!</h2>
			<p>Be the first to hear about our products (games, music, art) and receive free gifts and discount codes along the way.</p>
			<a href="/mailinglist" class="button">Sign up</a>
		</section>
	</div>
</Layout>

<style>
	.site-hero {
		position: relative;
		overflow: hidden;
		width: 100vw;
		margin-left: calc(50% - 50vw);
		margin-right: calc(50% - 50vw);
		margin-top: -96px;
		display: flex;
		align-items: center;
	}
	.bg-video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 50%;
		z-index: 0;
	}
	@media (max-width: 768px) {
		.bg-video {
			display: none;
		}
		.site-hero {
			background-image: url("/img/common/cp-splash.png");
			background-size: cover;
			background-position: 50% 50%;
		}
	}
	.hero-content {
		position: relative;
		z-index: 2;
		display: flex;
		justify-content: flex-start;
		padding-top: 150px;
		padding-bottom: 150px;
	}
	.site-hero .inner {
		text-align: left;
		max-width: 350px;
	}
	.site-hero .mark {
		height: 170px;
		margin: 0 0 26px 0;
	}
	.site-hero h1 {
		font-size: var(--fs-2xl);
		margin: 0;
		font-weight: 300;
		line-height: 1;
		color: #fff;
	}
	.site-hero .subhead {
		font-size: var(--fs-md);
		color: #dcdfd0;
		margin: 16px 0 0;
	}
	.site-hero .subhead em {
		font-style: italic;
		color: var(--cp-green);
	}

	.button {
		display: inline-block;
		background: var(--cp-green);
		color: #0c0f08;
		font-weight: 700;
		text-decoration: none;
		padding: 12px 26px;
		border-radius: 999px;
	}

	.page-head {
		padding-top: 64px;
	}
	.page-head h2 {
		font-size: var(--fs-xl);
		margin: 0;
		font-weight: 300;
	}
	.page-head .accent {
		color: var(--cp-green);
	}
	.page-head p {
		color: var(--cp-text-faint);
		
	}

	.games {
		display: grid;
		grid-template-columns: 1fr;
		gap: 40px 26px;
	}
	@media (min-width: 720px) {
		.games {
			grid-template-columns: repeat(3, 1fr);
		}
	}
	.games.minis {
		grid-template-columns: 1fr;
		gap: 16px;
	}
	@media (min-width: 768px) {
		.games.minis {
			grid-template-columns: repeat(4, 1fr);
			gap: 34px 26px;
		}
	}

	.minis-head h2 {
		font-size: var(--fs-3xl);
		margin: 0;
		font-weight: 300;
	}
	.minis-head p {
		color: var(--cp-text-faint);
		font-size: var(--fs-base);
	}

	.mailinglist h2 {
		font-weight: 300;
		font-size: var(--fs-xl);
		margin: 0 0 12px;
	}
	.mailinglist p {
		color: var(--cp-text-faint);
	}
</style>
