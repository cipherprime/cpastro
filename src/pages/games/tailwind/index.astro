---
import GameLayout from "../../../layouts/GameLayout.astro";
import Hero from "../../../components/games/Hero.astro";
import GameAbout from "../../../components/games/GameAbout.astro";
import Gallery from "../../../components/games/Gallery.astro";
import PressSpotlight from "../../../components/games/PressSpotlight.astro";
import MusicGrid from "../../../components/games/MusicGrid.astro";
import Credits from "../../../components/games/Credits.astro";
import { games } from "../../../data/games";

const game = games.find((g) => g.slug === "tailwind")!;

const quotes = [
	{ quote: "IT'S FROM CIPHER PRIME!?", cite: "Prince Jones" },
	{ quote: "Just installed and played—that is some awesome exclusive game.", cite: "David Bauer" },
	{ quote: "dank", cite: "charlieatron" },
	{ quote: "SH*************************T WHEN, WHERE, HOW, PRICE?", cite: "Michael Khang" },
];

const musicItems = [
	{
		cover: "/img/games/tailwind/tailwind_keravnos_cover.webp",
		kind: "Single",
		title: "Keravnós",
		desc: "The Tailwind theme, plus an orchestral version.",
		href: "https://cipherprime.bandcamp.com/album/keravn-s",
	},
];
---

<GameLayout title={game.title} description={game.longDescription} platforms={game.platforms} accent={game.accent}>
	<Hero
		title={game.title}
		logoSrc={game.heroLogo}
		tagline={game.shortDescription}
		backgroundSrc={game.heroBackground}
		trailerHref={game.trailerHref}
		compact={game.compactHero}
		platforms={game.platforms}
	/>

	<GameAbout heading="Before you die, live.">
		<p>You are the last survivor of an alien invasion that has all but destroyed your homeworld. Barely escaping the atmosphere in your experimental ship, the Keravnós, you realize you don't have enough fuel to survive.</p>
		<p>If this is your time, you might as well spend it doing what you do best: aerial ballet. Rain from the heavens as a bolt of lightning in one final blaze of glory.</p>
		<p><em>Tailwind: Prologue</em> was released exclusively in the Humble Monthly Bundle as a Humble Original in April 2016.</p>
	</GameAbout>

	<Gallery images={["/img/games/tailwind/tailwind1.jpg", "/img/games/tailwind/tailwind2.jpg", "/img/games/tailwind/tailwind3.jpg"]} />

	<PressSpotlight quotes={quotes} backgroundSrc="/img/games/tailwind/tailwind2.jpg" accent={game.accent} />

	<MusicGrid items={musicItems} />

	<Credits
		groups={[
			{
				heading: "The Team",
				names: [
					{ name: "Dain Saint", href: "https://twitter.com/dainsaint" },
					{ name: "William Stallwood", href: "https://twitter.com/willstall" },
				],
			},
			{
				heading: "Special Thanks",
				names: [
					{ name: "Mike Ambrogi", href: "https://twitter.com/mikeambrogi" },
					{ name: "Tim Ambrogi", href: "https://twitter.com/westquote" },
				],
			},
			{
				heading: "The Humble Team",
				names: [
					{ name: "John Graham", href: "https://twitter.com/wolfirejohn" },
					{ name: "Robert Bowling", href: "https://twitter.com/fourzerotwo" },
					{ name: "John Polson", href: "https://twitter.com/JohnPolson" },
					{ name: "Jackie Lee", href: "https://twitter.com/ohhellojackie" },
				],
			},
			{
				heading: "Faithful Interning",
				names: [{ name: "Andrew Cotter", href: "https://twitter.com/thatcotter" }],
			},
			{
				heading: "Moral Support",
				names: [{ name: "Philly Dev Night", href: "https://phillydevnight.com" }],
			},
		]}
	/>
</GameLayout>
