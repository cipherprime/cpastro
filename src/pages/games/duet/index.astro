---
import GameLayout from "../../../layouts/GameLayout.astro";
---

<GameLayout title="Auditorium Duet" description="The long-announced sequel to Auditorium.">
	<section class="notice">
		<h1>Auditorium Duet</h1>
		<p>Auditorium Duet was announced as the sequel to <a href="/games/auditorium">Auditorium</a>, but was never released. This page is kept for reference.</p>
	</section>
</GameLayout>

<style>
	.notice {
		max-width: 640px;
		margin: 0 auto;
		padding: 160px 24px 100px;
		text-align: center;
	}
	.notice p {
		color: var(--cp-text-dim);
	}
</style>
