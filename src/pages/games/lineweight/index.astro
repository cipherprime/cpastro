---
import GameLayout from "../../../layouts/GameLayout.astro";
import Hero from "../../../components/games/Hero.astro";
import GameAbout from "../../../components/games/GameAbout.astro";
import Gallery from "../../../components/games/Gallery.astro";
import PressSpotlight from "../../../components/games/PressSpotlight.astro";
import Credits from "../../../components/games/Credits.astro";
import { games } from "../../../data/games";

const game = games.find((g) => g.slug === "lineweight")!;



const accolades = [
	{ label: "Gold Medal, Interactive Design", source: "Indigo Awards 2019" },
	{ label: "Gold Medal, Book Design", source: "Indigo Awards 2019" },
	{ label: "Silver Medal, Mobile Games", source: "Indigo Awards 2019" },
	{ label: "Nominee", source: "IndieCade 2019" },
	{ label: "Nominee", source: "IndieCade Europe 2019" },
];
---

<GameLayout title={game.title} description={game.longDescription} image="/img/games/lineweight/lineweight_social.jpg" platforms={game.platforms} accent={game.accent}>
	<Hero
		title={game.title}
		tagline={game.shortDescription}
		backgroundSrc={game.heroBackground}
		trailerHref={game.trailerHref}
		compact={game.compactHero}
		platforms={game.platforms}
	/>
	<GameAbout heading="Feel something.">
		<p>A face, a sunset, a moment in time—our lives are the emotions we feel, and the stories we tell. These are our stories.</p>
		<p>Each of Lineweight's five chapters showcases a story with a specific emotional focus, illuminated with the studio's signature stylings of color, light, and music. Every moment, word, and image is controlled by your swipe, marrying storytelling and graphic design in a unique union.</p>
	</GameAbout>
	<Gallery vertical images={["/img/games/lineweight/lineweight1.jpg", "/img/games/lineweight/lineweight2.jpg", "/img/games/lineweight/lineweight3.jpg", "/img/games/lineweight/lineweight4.jpg", "/img/games/lineweight/lineweight5.jpg"]} />



	<PressSpotlight accolades={accolades} accent={game.accent} />

	<Credits
		groups={[
			{
				heading: "Credits",
				names: [
					{ name: "William Stallwood", href: "https://twitter.com/willstall" },
					{ name: "Dain Saint", href: "https://twitter.com/dainsaint" },
				],
			},
			{
				heading: "The Label",
				names: [{ name: "Eddie Hsu" }, { name: "Mike Ouye" }],
			},
			{
				heading: "Beta Testers",
				names: [
					{ name: "Kotaro Fujita" },
					{ name: "Nicole Forester" },
					{ name: "Jude Buffum" },
					{ name: "Emma Fried-Cassorla" },
					{ name: "Alex Hillman" },
					{ name: "Greg Lobanov" },
					{ name: "Jess Mason" },
					{ name: "Ichiro Lambe" },
				],
			},
			{
				heading: "Special Thanks",
				names: [
					{ name: "Robert Bowling", href: "https://twitter.com/fourzerotwo" },
					{ name: "Shawn Pierre", href: "https://twitter.com/ShawnPierre" },
					{ name: "Indy Hall", href: "https://indyhall.org" },
					{ name: "Philly Game Mechanics", href: "https://phillygamemechanics.com" },
					{ name: "Pexels", href: "https://pexels.com" },
				],
			},
		]}
	/>
</GameLayout>
