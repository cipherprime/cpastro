---
import GameLayout from "../../../layouts/GameLayout.astro";
import Hero from "../../../components/games/Hero.astro";
import PullQuote from "../../../components/games/PullQuote.astro";
import GameAbout from "../../../components/games/GameAbout.astro";
import Gallery from "../../../components/games/Gallery.astro";
import Press from "../../../components/games/Press.astro";
import MusicGrid from "../../../components/games/MusicGrid.astro";
import Credits from "../../../components/games/Credits.astro";
import { games } from "../../../data/games";

const game = games.find((g) => g.slug === "intake")!;

const quotes = [
	{ quote: "Intake is a spectacularly minimal game that contains a staggering amount of complexity with just a handful of straightforward concepts.", cite: "Daniel Starkey, Gamespot" },
	{ quote: "Intake is an intense, bass-dropping arcade experience.", cite: "Andrew Groen, Penny Arcade Report" },
	{ quote: "Super simple and super addicting.", cite: "Jessica Conditt, Joystiq" },
	{ quote: "100% undiluted, pulse-pounding fun. 5/5.", cite: "Jarrett Redding, Mash Those Buttons" },
];

const accolades = [
	{ label: "5/5", source: "Mash Those Buttons" },
	{ label: "Bass-dropping arcade experience", source: "Penny Arcade Report" },
	{ label: "Super addicting", source: "Joystiq" },
];

const musicItems = [
	{
		cover: "/img/games/intake/intake_ost_cover.webp",
		kind: "Soundtrack",
		title: "Intake OST",
		desc: "The electric soundtrack to Intake.",
		href: "https://cipherprime.bandcamp.com/album/intake-ost",
	},
];
---

<GameLayout title={game.title} description={game.longDescription} image="/img/games/intake/intake_social.jpg" platforms={game.platforms}>
	<Hero
		title={game.title}
		logoSrc={game.heroLogo}
		tagline={game.shortDescription}
		backgroundSrc={game.heroBackground}
		trailerHref={game.trailerHref}
		compact={game.compactHero}
		platforms={game.platforms}
	/>

	<PullQuote quote="An intense, bass-dropping arcade experience." cite="Andrew Groen, Penny Arcade Report" />

	<Gallery images={["/img/games/intake/intake1.jpg", "/img/games/intake/intake2.jpg", "/img/games/intake/intake3.jpg"]} />

	<GameAbout heading="Grab some quarters & strap in.">
		<p>Intake is the retro-futuristic drugstep arcade shooter from Cipher Prime. In this polychromatic love child of Dr. Mario and Ikaruga, you battle a never-ending barrage of pills, pushing your skill and reflexes to the limit to avoid a lethal dosage.</p>
		<p>Blast and combo your way through an epic cascade of audiovisual mayhem so intoxicating it comes with its own warning label.</p>
	</GameAbout>

	<Press quotes={quotes} accolades={accolades} />

	<MusicGrid items={musicItems} />

	<Credits
		groups={[
			{
				heading: "Credits",
				names: [
					{ name: "William Stallwood", href: "https://twitter.com/willstall" },
					{ name: "Dain Saint", href: "https://twitter.com/dainsaint" },
					{ name: "Andrei Marks", href: "https://twitter.com/andreimarks" },
					{ name: "Aaron Chapin", href: "https://twitter.com/achapin" },
					{ name: "Jackie Awesome", href: "https://twitter.com/ajackieawesome" },
					{ name: "Zenas Bellace", href: "https://twitter.com/zenasprime" },
				],
			},
		]}
	/>
</GameLayout>
